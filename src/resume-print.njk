---
permalink: /resume/print/index.html
eleventyExcludeFromCollections: true
---
{#- Print layout for the resume PDF. `npm run resume:pdf` renders this page to src/static/resume.pdf.
    It shows roles from 2013 on in full and lists older roles without dates. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<title>{{ site.name }} — Resume</title>
<style>
  @font-face { font-family: "Inter"; src: url("/fonts/inter-latin-var.woff2") format("woff2"); font-weight: 100 900; }
  @page { size: Letter; margin: 0.6in 0.7in; }
  * { box-sizing: border-box; }
  body { margin: 0; font: 9.6pt/1.42 "Inter", system-ui, sans-serif; color: #17191a; }
  a { color: inherit; text-decoration: none; }
  h1 { font-size: 22pt; letter-spacing: -0.03em; margin: 0; line-height: 1.1; }
  .tagline { font-size: 11pt; color: #0d5c46; font-weight: 600; margin: 2pt 0 5pt; }
  .contact { font-size: 9pt; color: #444; margin: 0; }
  .contact span + span::before { content: "  ·  "; color: #999; }
  h2 {
    font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.1em; color: #0d5c46;
    border-bottom: 1px solid #cfd6d2; padding-bottom: 2pt; margin: 12pt 0 6pt;
  }
  p { margin: 0 0 4pt; }
  .skills { margin: 0; display: grid; grid-template-columns: 1.45in 1fr; gap: 2pt 8pt; }
  .skills dt { font-weight: 650; }
  .skills dd { margin: 0; color: #333; }
  .job { margin-bottom: 8pt; break-inside: avoid; }
  .job__head { display: flex; justify-content: space-between; align-items: baseline; gap: 8pt; }
  .job__role { font-weight: 700; font-size: 10.3pt; }
  .job__org { color: #444; font-weight: 500; }
  .job__dates { color: #444; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
  ul { margin: 2pt 0 0; padding-left: 12pt; }
  li { margin-bottom: 1.5pt; }
  li::marker { color: #0d5c46; }
  .earlier { color: #333; }
</style>
</head>
<body>
  <h1>{{ site.name }}</h1>
  <p class="tagline">Senior Web Developer &amp; Team Lead · AI-Assisted Development</p>
  <p class="contact">
    <span>{{ site.location }}</span><span><a href="mailto:{{ site.email }}">{{ site.email }}</a></span><span>{{ site.phone }}</span><span><a href="{{ site.url }}">alexbeuscher.com</a></span><span><a href="{{ site.linkedin }}">LinkedIn</a></span><span><a href="{{ site.github }}">github.com/abeuscher</a></span>
  </p>

  <h2>Summary</h2>
  <p>Senior web developer and team lead who has been the lead or sole developer inside marketing departments at 2K Games, Skydio, Contentstack, and Dynamic Signal. I've cut page load from 14 seconds to 2.5, doubled site conversions, consolidated five systems into one headless CMS, and led a six-person remote team. In 2026 I designed and shipped a full CRM platform with AI coding agents under strict review, with 3,100+ automated tests.</p>

  <h2>Skills</h2>
  <dl class="skills">
    {%- for group in skills %}
    <dt>{{ group.label }}</dt><dd>{{ group.items | join(", ") }}</dd>
    {%- endfor %}
  </dl>

  <h2>Experience</h2>
  {%- set older = [] %}
  {%- for e in history %}
  {%- if not e.earlier and (e.start | int) >= 2013 %}
  <div class="job">
    <div class="job__head">
      <span><span class="job__role">{{ e.role }}</span> <span class="job__org">· {{ e.org }}{% if e.location %}, {{ e.location }}{% endif %}</span></span>
      <span class="job__dates">{{ e.start }} – {{ e.end }}</span>
    </div>
    <ul>{% for b in e.bullets %}<li>{{ b | markdownInline | safe }}</li>{% endfor %}</ul>
  </div>
  {%- elif "web" in e.tags or "copy" in e.tags %}
  {%- set older = (older.push(e.role + ", " + e.org), older) %}
  {%- endif %}
  {%- endfor %}

  <h2>Earlier experience</h2>
  <p class="earlier">{{ older | join(" · ") }}</p>

  <h2>Education</h2>
  <p><strong>Emerson College</strong>, Boston, MA. BFA in Writing, Literature &amp; Publishing.</p>
</body>
</html>
